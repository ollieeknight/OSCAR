workDir = '/sc-scratch/sc-scratch-cc12-ag-romagnani/nf_work_oscar'

manifest {
    name            = 'OSCAR'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

env {
    APPTAINER_TMPDIR   = '/sc-scratch/sc-scratch-cc12-ag-romagnani/tmp/nf_work_oscar'
    APPTAINER_CACHEDIR = '/sc-scratch/sc-scratch-cc12-ag-romagnani/apptainer_cache'
}

params {
    // Input
    samplesheet        = null   // path to metadata.csv
    bcl_dir            = null   // path to BCL folder containing RunInfo.xml
    // Parent that {run_name}_outs is created in.
    //
    // Publishers write to "${params.outdir}/${run_name}_outs/...". Left unset,
    // this resolves beside whichever input folder the run was launched from, so
    // a sequencing folder only grows {run}_fastq and, for the last run of a
    // resequencing chain, {run}_outs. A fixed --outdir instead collects every
    // merged run under the primary run's folder.
    //
    // An expression rather than an if-block: the strict config parser
    // (Nextflow 25.10+) rejects statements at config top level and exposes
    // neither top-level variables nor file(), hence java.io.File.
    // preflight_check reports a missing input path; fall back here.
    outdir             = ([bcl:        params.bcl_dir,
                            fastq:      params.fastq_dir,
                            cellranger: params.outs_dir][(params.run_from ?: 'bcl').toString().toLowerCase()]
                           ?.with { anchor -> new File(anchor).absoluteFile.parent }) ?: 'results'
    run_from           = 'bcl'  // entry point: 'bcl' | 'fastq' | 'cellranger'
    fastq_dir          = null   // required when run_from = 'fastq'
    outs_dir           = null   // required when run_from = 'cellranger'
    adt_files_dir      = null   // Path to ADT CSV files ({adt_file}.csv)

    // Flex options
    flex_backend          = 'cellranger'  // 'cellranger' | 'cyto' | 'both'
    flex_probe_set        = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/hs/10x/Chromium_Human_Transcriptome_Probe_Set_v2.0.0_GRCh38-2024-A.csv"
    flex_probe_set_custom = null          // OPTIONAL: custom probe CSV (semicolon-delimited OSCAR format)
    flex_samples_file     = null          // REQUIRED for Flex multiplex: path to samples CSV
    flex_cyto_memory_limit = '8GiB'

    macs3_qvalue = 0.05     // FDR threshold for peak calling

    // Multi-flowcell options
    extra_bcl_dirs     = null   // comma-separated additional BCL dirs
    extra_samplesheets = null   // comma-separated samplesheets for extra BCL dirs
    run_name           = null   // output prefix; auto-derived from bcl_dir if not set

    // Demux QC thresholds (advisory warnings only, never fail a run)
    // A declared library this many times below its lane's median sibling is
    // reported as a dropout — a failed library sits orders of magnitude down,
    // not merely low, so the test is a ratio rather than an absolute floor.
    demux_qc_dropout_ratio = 100
    // An unknown barcode at or above this percent of lane reads is reported
    // when it also matches a known kit index in assets/indexes/.
    demux_qc_unknown_pct   = 1

    // References
    ref_human          = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/hs/GRCh38-hardmasked-optimised-arc"
    ref_vdj_human      = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/hs/GRCh38-IMGT-VDJ-2024"
    ref_mouse          = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/mm/GRCm38-hardmasked-optimised-arc"
    ref_vdj_mouse      = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/mm/GRCm38-IMGT-VDJ-2024"
    snp_vcf            = "/sc-projects/sc-proj-cc12-ag-romagnani/ref/hs/SNP/genome1K.phase3.SNP_AF5e2.chr1toX.hg38.vcf.gz"
    atac_whitelist     = "/home/knighto/bin/cellranger-atac-2.2.0/lib/python/atac/barcodes/737K-cratac-v1.txt.gz"
    viral_piscem_index = "/home/knighto/work/ref/rvdb/piscem_index/index"
    viral_t2g          = "/home/knighto/work/ref/rvdb/piscem_index/t2g.tsv"
    tenx_barcodes_dir  = "/home/knighto/bin/cellranger-10.0.0/lib/python/cellranger/barcodes"
    // Staged by Nextflow — an https:// URL is downloaded on the head node into a
    // per-session stage dir and symlinked into each task. Reused across tasks and
    // on -resume; a fresh run re-downloads. Replace with a local path if the head
    // node has no outbound network.
    bamtofastq_bin     = "https://github.com/10XGenomics/bamtofastq/releases/download/v1.4.1/bamtofastq_linux"

    // Optional analyses: comma-separated list, e.g. --extras velocity,viral
    extras             = null
    spliceu_index_human = "/home/knighto/work/ref/hs/GRCh38-hardmasked-optimised-arc-simpleaf/index"
    spliceu_index_mouse = "/home/knighto/work/ref/mm/GRCm38-hardmasked-optimised-arc-simpleaf/index"

    sequencer = 'novaseq_x'

    // Containers
    container_python            = "quay.io/biocontainers/python:3.12"
    container_bclconvert        = "quay.io/nf-core/bclconvert:4.5.4"
    container_cellranger        = "quay.io/nf-core/cellranger:10.0.0"
    container_cellranger_atac   = "quay.io/nf-core/cellranger-atac:2.1.0"
    container_cyto              = "/sc-scratch/sc-scratch-cc12-ag-romagnani/apptainer_cache/cyto.sif"
    container_amulet            = "quay.io/cellgeni/amulet:1.1"
    container_mgatk             = "quay.io/ollieeknight/mgatk2:1.4.0"
    container_asap              = "quay.io/ollieeknight/asap_to_kite:v0.2.0"
    container_cellbender        = "/sc-scratch/sc-scratch-cc12-ag-romagnani/apptainer_cache/cellbender_sc1.sif"
    container_scrublet          = "community.wave.seqera.io/library/python_pyyaml_scanpy_scikit-image:750e7b74b6d036e4"
    container_fastp             = "quay.io/biocontainers/fastp:1.3.5--h43da1c4_0"
    container_pigz              = "quay.io/biocontainers/pigz:2.8"
    container_multiqc           = "quay.io/biocontainers/multiqc:1.34--pyhdfd78af_0"
    container_kallisto          = "quay.io/biocontainers/kallisto:0.52.0--h13ff97a_0"
    container_bustools          = "quay.io/biocontainers/bustools:0.45.1--h6f0a7f7_0"
    container_cellsnp           = "quay.io/biocontainers/cellsnp-lite:1.2.3--ha0c3a46_6"
    container_vireo             = "quay.io/biocontainers/vireosnp:0.5.9--pyh7e72e81_0"
    container_simpleaf          = "quay.io/biocontainers/simpleaf:0.25.0--hd612981_0"
    container_macs3             = "quay.io/biocontainers/macs3:3.0.4--py310h5a5e57a_0"

    multiqc_config = "${projectDir}/assets/multiqc_config.yaml"
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor      = 'slurm'
        process.queue         = 'compute'
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.cacheDir    = '/sc-scratch/sc-scratch-cc12-ag-romagnani/apptainer_cache'
        apptainer.envWhitelist = ['APPTAINER_TMPDIR', 'APPTAINER_CACHEDIR', 'CUDA_VISIBLE_DEVICES', 'CUDA_HOME']
        apptainer.runOptions   = '--bind /charite-store-f/f-cc12-ag-romagnani --bind /sc-projects/sc-proj-cc12-ag-romagnani --bind /sc-scratch/sc-scratch-cc12-ag-romagnani --bind /home/knighto'
        process.clusterOptions  = '--exclude=s-sc-node038'  // broken sssd prevents Apptainer UID resolution

        process {
            errorStrategy = { task.exitStatus == 143 ? 'retry' : 'finish' }
            maxRetries    = 2

            // ── Demux
            withName: 'GENERATE_SAMPLESHEET' {
                cpus   = 1; memory = 1.GB; time = 1.h
            }
            withName: 'BCLCONVERT' {
                cpus          = { 16 * task.attempt }
                memory        = { 128.GB * task.attempt }
                time          = { 4.h * task.attempt }
                errorStrategy = 'retry'
                maxRetries    = 2
            }
            withName: 'FASTP' {
                cpus   = 2; memory = 8.GB; time = 4.h
            }
            withName: 'VALIDATE_FASTQ' {
                // Only the files fastp skips: index reads and sub-1MB R-reads
                // (see subworkflows/fastq_qc.nf). `pigz -t` on a single-member
                // gzip stream runs serially, so a larger request idles a slot.
                cpus   = 2; memory = 4.GB; time = 2.h
            }
            withName: 'MULTIQC' {
                cpus   = 2; memory = 8.GB; time = 2.h
            }

            // Flex processing
            withName: 'FLEX_PROBE_PREPARE|FLEX_SAMPLE_PREPARE' {
                cpus   = 1; memory = 1.GB; time = 1.h
            }
            withName: 'FLEX_BARCODE_EXTRACT|FLEX_WHITELIST_EXTRACT' {
                cpus   = 1; memory = 1.GB; time = 1.h
            }

            // GEX
            withName: 'CELLRANGER_MULTI' {
                cpus   = 64; memory = 128.GB; time = 48.h
            }
            withName: 'CYTO_FLEX' {
                cpus   = 16; memory = 64.GB; time = 24.h
            }
            withName: 'CYTO_RENAME_SAMPLES' {
                cpus   = 1; memory = 1.GB; time = 1.h
            }

            // ATAC counting
            withName: 'CELLRANGER_ATAC' {
                cpus   = 64; memory = 128.GB; time = 48.h
            }

            // ADT counting (ASAP kallisto)
            withName: 'FEATUREMAP' {
                cpus   = 1; memory = 2.GB; time = 1.h
            }
            withName: 'KALLISTO_INDEX' {
                cpus   = 1; memory = 2.GB; time = 1.h
            }
            withName: 'ASAP_TO_KITE' {
                cpus   = 8; memory = 16.GB; time = 2.h
            }
            withName: 'KALLISTO_BUS' {
                cpus   = 16; memory = 96.GB; time = 48.h
            }
            withName: 'BUSTOOLS_CORRECT' {
                cpus   = 2; memory = 8.GB; time = 2.h
            }
            withName: 'BUSTOOLS_SORT' {
                cpus   = 8; memory = 32.GB; time = 4.h
            }
            withName: 'BUSTOOLS_COUNT' {
                cpus   = 2; memory = 8.GB; time = 2.h
            }

            // GEX QC
            withName: 'CELLBENDER' {
                queue            = 'gpu'
                clusterOptions   = '--exclude=s-sc-node038 --gres=gpu:1'
                containerOptions = '--nv'
                cpus             = 16
                memory           = 96.GB
                time             = 24.h
            }
            withName: 'SCRUBLET' {
                cpus   = 4; memory = 16.GB; time = 4.h
            }
            withName: 'VIRAL_DETECT|SIMPLEAF_VELOCITY' {
                clusterOptions = '--exclude=s-sc-node038 --constraint=amd_genoa|amd_turin'
                cpus           = 16
                memory         = 64.GB
                time           = 24.h
            }

            // ATAC QC
            withName: 'AMULET' {
                cpus   = 4; memory = 16.GB; time = 4.h
            }
            withName: 'MGATK2' {
                cpus   = 32; memory = 128.GB; time = 48.h
            }
            withName: 'MACS3' {
                cpus   = 4; memory = 16.GB; time = 4.h
            }

            // Genotyping
            withName: 'CELLSNP_LITE' {
                cpus   = 32; memory = 64.GB; time = 48.h
            }
            withName: 'VIREO' {
                cpus   = 32; memory = 64.GB; time = 48.h
            }
        }
    }
}
